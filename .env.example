# Переменные для docker-compose (прод-развёртывание).
# Скопируйте в .env рядом с docker-compose.yml и заполните реальными значениями:
#   cp .env.example .env

# --- Supabase ---
# Project Settings → API в дашборде Supabase.
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# --- API-контейнер ---
# Порт, который слушает Express внутри контейнера. Меняется только если он
# конфликтует с чем-то ещё внутри контейнера — наружу не публикуется.
PORT=3001

# --- Фронтенд-контейнер ---
# Хостовый порт, на который docker-compose публикует nginx с собранным сайтом.
# Именно на него должен смотреть внешний reverse-proxy (Traefik/nginx/etc),
# который на сервере уже обрабатывает TLS и домен.
WEB_PORT=8080
